{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Jukebox",
  "version": "0.1.0",
  "identifier": "org.teachstack.jukebox",
  "build": {
    "beforeDevCommand": "pnpm dev --host 0.0.0.0",
    "devUrl": "http://127.0.0.1:5173/host",
    "frontendDist": "https://jukebox.teachstack.org/host"
  },
  "app": {
    "windows": [
      {
        "title": "Jukebox",
        "width": 1024,
        "height": 768
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
